# ==============================================================================
# ResQTrack Incident AI System -- Environment Template (Copy to ".env")
# Safe to keep on another PC for local or Docker runs; ".env" is gitignored.
# ==============================================================================

# Claude AI Vision & Forensics Key (Required for AI Gov-ID OCR, 1:1 Face Match & Scene Vision)
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_FALLBACK_MODEL=claude-sonnet-5-5
CLAUDE_INCIDENT_VISION_MODEL=claude-haiku-4-5-20251001

# Roboflow Serverless Keys & Workflows (Header Auth, 15-min Workflow Cache)
ROBOFLOW_API_KEY=REPLACE_WITH_YOUR_ROBOFLOW_API_KEY
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_MODEL_ID=accident-and-non-accident-label-image-dataset/14
ROBOFLOW_WORKSPACE_NAME=
ROBOFLOW_FACE_WORKFLOW_ID=
ROBOFLOW_FACE_CLASSES=face
ROBOFLOW_ID_WORKFLOW_ID=
ROBOFLOW_PHILIPPINE_IDS_MODEL_ID=philippine-ids/1
ROBOFLOW_ID_CLASSES=driver, postal, umid
ROBOFLOW_USE_CACHE=true
ROBOFLOW_CACHE_TTL_MINUTES=15

# Database Provider: "PostgreSql" (default in Docker) | "SqlServer" | "MySql"
DATABASE_PROVIDER=PostgreSql
POSTGRES_DB=ResQTrackDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourPassword123!

# Optional Host/Custom Port Overrides
ADMIN_PORT=1996
RESPONDER_PORT=1997
CIVILIAN_PORT=1998
BACKEND_PORT=1999
POSTGRES_PORT=5432
POSTGRES_REPLICA_PORT=5433
REDIS_PORT=6379
PGADMIN_PORT=5050

# Security & Cross-PC LAN Origins (comma-separated, optional)
VERIFICATION_HMAC_SECRET=RESQTRACK-V2-TOKEN-HMAC-SHA256-DEV-SIGNING-KEY-2026-KATIPUNAN-7109
ALLOWED_ORIGINS=
