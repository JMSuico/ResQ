# ==============================================================================
# ResQTrack Incident AI System -- Environment Template (Copy to ".env")
# Safe to keep on another PC for local or Docker runs; ".env" is gitignored.
# ==============================================================================

# Claude AI Vision & Forensics Key (Required for AI Gov-ID OCR & 1:1 Face Match)
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_FALLBACK_MODEL=claude-sonnet-5-5

# Database Provider: "PostgreSql" (default in Docker) | "SqlServer" | "MySql"
DATABASE_PROVIDER=PostgreSql
POSTGRES_DB=ResQTrackDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourPassword123!

# Optional Host/Custom Port Overrides
ADMIN_PORT=1996
RESPONDER_PORT=1997
CIVILIAN_PORT=1998
BACKEND_PORT=1999
POSTGRES_PORT=5432
POSTGRES_REPLICA_PORT=5433
REDIS_PORT=6379
PGADMIN_PORT=5050

# Security & Cross-PC LAN Origins (comma-separated, optional)
VERIFICATION_HMAC_SECRET=RESQTRACK-V2-TOKEN-HMAC-SHA256-DEV-SIGNING-KEY-2026-KATIPUNAN-7109
ALLOWED_ORIGINS=
