# ResQTrack Incident AI -- Dedicated Civilian SOS Portal (:1998)
FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --legacy-peer-deps || npm install --legacy-peer-deps
COPY . .
EXPOSE 1998
ENV PORT=1998
ENV BACKEND_URL=http://resqtrack-backend:1999
CMD ["npm", "run", "dev:civilian"]
