# ResQTrack Incident AI -- Dedicated Emergency Responders Portal (:1997)
FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --legacy-peer-deps || npm install --legacy-peer-deps
COPY . .
EXPOSE 1997
ENV PORT=1997
ENV BACKEND_URL=http://resqtrack-backend:1999
CMD ["npm", "run", "dev:responder"]
